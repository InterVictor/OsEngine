<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsComputersUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPS — computers with access" Height="380" Width="820"
        Style="{StaticResource WindowStyleCanResize}"
        WindowStartupLocation="CenterOwner" MinWidth="600" MinHeight="250"
        Icon="/Images/OsLogo.ico">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,6"
                   Text="SSH keys allowed to log in to the VPS (~/.ssh/authorized_keys). Keys made by Robots.VPS are named osengine-client-&lt;computer&gt;-&lt;date&gt;. Revoke the key of a lost or replaced computer; the root password keeps working for connecting a computer again."/>
        <DataGrid Grid.Row="1" Name="DataGridKeys" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Single" Style="{StaticResource DataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Computer / key name" Width="*" Binding="{Binding Comment}"/>
                <DataGridTextColumn Header="" Width="110" Binding="{Binding Marker}"/>
                <DataGridTextColumn Header="Type" Width="80" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Fingerprint" Width="360" Binding="{Binding Fingerprint}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Label Name="LabelStatus" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Name="ButtonRefresh" Content="Refresh" Width="100" Height="28" Margin="0,0,5,0" Click="ButtonRefresh_Click"/>
            <Button Name="ButtonRevoke" Content="Revoke" Width="100" Height="28" Click="ButtonRevoke_Click"/>
        </StackPanel>
    </Grid>
</Window>
