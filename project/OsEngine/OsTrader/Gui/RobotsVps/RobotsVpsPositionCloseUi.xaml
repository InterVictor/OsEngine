<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsPositionCloseUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Position close" Height="580" Width="600" MinWidth="600" MinHeight="580" Icon="/Images/OsLogo.ico" Style="{StaticResource WindowStyleCanResize}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="0,0,0,301" HorizontalAlignment="Left" Width="187">
            <Label Name="LabelServerType" Content="Server:" HorizontalAlignment="Left" Margin="1,4,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelServerTypeValue" Content="BinanceFutures" HorizontalAlignment="Left" Margin="59,4,0,0" VerticalAlignment="Top" Width="128"/>
            <Label Name="LabelSecurity" Content="Security:" HorizontalAlignment="Left" Margin="1,30,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelSecurityValue" Content="BNBUSDT" HorizontalAlignment="Left" Margin="59,30,0,0" VerticalAlignment="Top" Width="128"/>
            <Label Name="LabelPosNumber" Content="Pos num:" HorizontalAlignment="Left" Margin="1,56,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelPosNumberValue" Content="Number" HorizontalAlignment="Left" Margin="59,56,0,0" VerticalAlignment="Top" Width="128"/>
            <Label Name="LabelOpenSide" Content="Side:" HorizontalAlignment="Left" Margin="1,82,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelOpenSideValue" Content="Buy" HorizontalAlignment="Left" Margin="59,82,0,0" VerticalAlignment="Top" Width="128"/>
            <Label Name="LabelOpenVolume" Content="Volume:" HorizontalAlignment="Left" Margin="1,108,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelOpenVolumeValue" Content="1.3" HorizontalAlignment="Left" Margin="59,108,0,0" VerticalAlignment="Top" Width="128"/>
            <Label Name="LabelPosState" Content="Pos state:" HorizontalAlignment="Left" Margin="1,134,0,0" VerticalAlignment="Top"/>
            <Label Name="LabelPosStateValue" Content="Open" HorizontalAlignment="Left" Margin="59,134,0,0" VerticalAlignment="Top" Width="128"/>
        </Grid>
        <TabControl Name="TabControlTypePosition" Margin="0,0,0,2" Height="299" VerticalAlignment="Bottom">
            <TabItem Header="Limit" Name="TabItemLimit" Width="100">
                <Grid>
                    <Label Name="LabelLimitPrice" Content="Price" HorizontalAlignment="Left" Margin="45,40,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxLimitPrice" HorizontalAlignment="Left" Margin="149,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelLimitVolumeToClose" Content="Volume to close" HorizontalAlignment="Left" Margin="45,68,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxLimitVolumeToClose" HorizontalAlignment="Left" Margin="149,68,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelLimitAllOpenVolumeSend" Content="All open volume: 1.3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="149,92,0,0" VerticalAlignment="Top" FontSize="10" Height="12" Width="199" Cursor="Hand" MouseLeftButtonDown="LabelLimitAllOpenVolumeSend_MouseLeftButtonDown"/>
                    <Button Name="ButtonCloseAtLimit" Height="38" Content="Close at limit" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtLimit_Click"/>
                    <Button Name="ButtonRevokeLimit" Height="38" Content="Revoke" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Width="90" Click="ButtonRevokeLimit_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Market" Name="TabItemMarket" Width="100">
                <Grid>
                    <Label Name="LabelMarketVolumeToClose" Content="Volume to close" HorizontalAlignment="Left" Margin="45,68,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxMarketVolumeToClose" HorizontalAlignment="Left" Margin="149,68,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelMarketAllOpenVolumeSend" Content="All open volume: 1.3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="149,92,0,0" VerticalAlignment="Top" FontSize="10" Height="12" Width="199" Cursor="Hand" MouseLeftButtonDown="LabelMarketAllOpenVolumeSend_MouseLeftButtonDown"/>
                    <Button Name="ButtonCloseAtMarket" Height="38" Content="Close at market" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtMarket_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Stop" Name="TabItemStop" Width="100">
                <Grid>
                    <Label Name="LabelStopActivationPrice" Content="Activation Price" HorizontalAlignment="Left" Margin="45,10,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxStopActivationPrice" HorizontalAlignment="Left" Margin="149,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelStopPrice" Content="Price" HorizontalAlignment="Left" Margin="45,38,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxStopPrice" HorizontalAlignment="Left" Margin="149,38,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <CheckBox Name="CheckBoxServerStopOrder" Content="Server stop order" HorizontalAlignment="Left" Margin="45,66,0,0" VerticalAlignment="Top" Click="CheckBoxServerStopOrder_Click"/>
                    <Label Name="LabelStopVolumeToClose" Content="Volume to close" HorizontalAlignment="Left" Margin="45,90,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxStopVolumeToClose" HorizontalAlignment="Left" Margin="149,90,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelStopAllOpenVolumeSend" Content="All open volume: 1.3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="149,114,0,0" VerticalAlignment="Top" FontSize="10" Height="12" Width="199" Cursor="Hand" MouseLeftButtonDown="LabelStopAllOpenVolumeSend_MouseLeftButtonDown"/>
                    <Button Name="ButtonCloseAtStop" Height="38" Content="Close at stop" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtStop_Click"/>
                    <Button Name="ButtonRevokeStop" Height="38" Content="Revoke" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Width="90" Click="ButtonRevokeStop_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Stop-Market" Name="TabItemStopMarket" Width="100">
                <Grid>
                    <Label Name="LabelStopMarketActivationPrice" Content="Activation Price" HorizontalAlignment="Left" Margin="45,10,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxStopMarketActivationPrice" HorizontalAlignment="Left" Margin="149,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <CheckBox Name="CheckBoxServerStopMarket" Content="Server stop order" HorizontalAlignment="Left" Margin="45,38,0,0" VerticalAlignment="Top" Click="CheckBoxServerStopMarket_Click"/>
                    <Label Name="LabelStopMarketVolumeToClose" Content="Volume to close" HorizontalAlignment="Left" Margin="45,62,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxStopMarketVolumeToClose" HorizontalAlignment="Left" Margin="149,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelStopMarketAllOpenVolumeSend" Content="All open volume: 1.3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="149,86,0,0" VerticalAlignment="Top" FontSize="10" Height="12" Width="199" Cursor="Hand" MouseLeftButtonDown="LabelStopMarketAllOpenVolumeSend_MouseLeftButtonDown"/>
                    <Button Name="ButtonCloseAtStopMarket" Height="38" Content="Close at stop market" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtStopMarket_Click"/>
                    <Button Name="ButtonRevokeStopMarket" Height="38" Content="Revoke" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Width="90" Click="ButtonRevokeStopMarket_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Profit" Name="TabItemProfit" Width="100">
                <Grid>
                    <Label Name="LabelProfitActivationPrice" Content="Activation Price" HorizontalAlignment="Left" Margin="45,10,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxProfitActivationPrice" HorizontalAlignment="Left" Margin="149,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelProfitPrice" Content="Price" HorizontalAlignment="Left" Margin="45,38,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxProfitPrice" HorizontalAlignment="Left" Margin="149,38,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Button Name="ButtonCloseAtProfit" Height="38" Content="Close at profit" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtProfit_Click"/>
                    <Button Name="ButtonRevokeProfit" Height="38" Content="Revoke" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8" Width="90" Click="ButtonRevokeProfit_Click"/>
                </Grid>
            </TabItem>

            <TabItem Header="Fake" Name="TabItemFake" Width="100">
                <Grid>
                    <Label Name="LabelFakeOpenDate" Content="Open Date" HorizontalAlignment="Left" Margin="45,3,0,0" VerticalAlignment="Top" Width="104"/>
                    <DatePicker Name="DatePickerFakeOpenDate" HorizontalAlignment="Left" Margin="149,3,0,0" VerticalAlignment="Top" Width="139"/>
                    <Label Name="LabelFakeOpenTime" Content="Open Time" HorizontalAlignment="Left" Margin="45,33,0,0" VerticalAlignment="Top" Width="104"/>
                    <TextBox Name="TextBoxFakeOpenTime" HorizontalAlignment="Left" Margin="149,33,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139"/>
                    <Button Name="ButtonFakeTimeOpenNow" Content="Now" HorizontalAlignment="Left" Margin="293,3,0,0" VerticalAlignment="Top" Height="53" Width="55" Click="ButtonFakeTimeOpenNow_Click"/>
                    <Label Name="LabelFakePrice" Content="Price" HorizontalAlignment="Left" Margin="45,61,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxFakePrice" HorizontalAlignment="Left" Margin="149,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelFakeVolume" Content="Volume" HorizontalAlignment="Left" Margin="45,89,0,0" VerticalAlignment="Top"/>
                    <TextBox Name="TextBoxFakeVolume" HorizontalAlignment="Left" Margin="149,89,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="199"/>
                    <Label Name="LabelFakeAllOpenVolume" Content="All open volume: 1.3" HorizontalAlignment="Left" HorizontalContentAlignment="Right" Margin="149,113,0,0" VerticalAlignment="Top" FontSize="10" Height="12" Width="199" Cursor="Hand" MouseLeftButtonDown="LabelFakeAllOpenVolume_MouseLeftButtonDown"/>
                    <Button Name="ButtonCloseAtFake" Height="38" Content="Close at fake" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" Width="180" Click="ButtonCloseAtFake_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
        <WindowsFormsHost Name="WinFormsHostMarketDepth" Margin="188,0,4,301"/>
    </Grid>
</Window>
