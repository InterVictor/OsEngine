<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OsEngine.OsTrader.Gui.RobotsVps"
        mc:Ignorable="d"
        Title="VPS — connection and administration" Height="750" Width="1100"
        Style="{StaticResource WindowStyleCanResize}"
        WindowStartupLocation="CenterScreen"
        MinWidth="700" MinHeight="450"
        Icon="/Images/OsLogo.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="200"/>
            <RowDefinition Height="150" MinHeight="100"/>
        </Grid.RowDefinitions>

        <!-- Строка подключения: адрес удалённого MCP API (обычно через SSH-туннель) и ключ -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Name="LabelUrl" Content="MCP URL" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Name="TextBoxUrl" VerticalAlignment="Center" Height="26" Margin="0,0,10,0"
                     Text="http://localhost:6510/api/v2/mcp"/>

            <Label Grid.Row="0" Grid.Column="2" Name="LabelApiKey" Content="API Key" VerticalAlignment="Center"/>
            <PasswordBox Grid.Row="0" Grid.Column="3" Name="PasswordBoxApiKey" VerticalAlignment="Center" Height="26" Margin="0,0,10,0"/>

            <Button Grid.Row="0" Grid.Column="4" Name="ButtonConnect" Content="Connect" Width="100" Height="28" Margin="0,0,5,0" Click="ButtonConnect_Click"/>
            <Button Grid.Row="0" Grid.Column="5" Name="ButtonDisconnect" Content="Disconnect" Width="100" Height="28" Margin="0,0,10,0" Click="ButtonDisconnect_Click" IsEnabled="False"/>

            <Ellipse Grid.Row="0" Grid.Column="6" Name="EllipseStatus" Width="14" Height="14" Fill="Gray" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <Label Grid.Row="0" Grid.Column="6" Name="LabelStatus" Content="Disconnected" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center"/>

            <Grid Grid.Row="1" Grid.ColumnSpan="8" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="105"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="95"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="SSH host" FontSize="11" Foreground="Gray"/>
                    <TextBox Name="TextBoxSshHost" Height="24" Text="188.130.227.40"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="SSH user" FontSize="11" Foreground="Gray"/>
                    <TextBox Name="TextBoxSshUser" Height="24" Text="root"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="OpenSSH private key file (passphrase-free key)" FontSize="11" Foreground="Gray"/>
                    <TextBox Name="TextBoxSshKeyPath" Height="24"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Local port" FontSize="11" Foreground="Gray"/>
                    <TextBox Name="TextBoxSshLocalPort" Height="24" Text="6510"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="VPS API port" FontSize="11" Foreground="Gray"/>
                    <TextBox Name="TextBoxSshRemotePort" Height="24" Text="6500"/>
                    <CheckBox Name="CheckBoxAutoConnectSsh" Content="Connect SSH automatically on program start" Margin="0,4,0,0" Click="CheckBoxAutoConnectSsh_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Серверы и боты удалённого терминала -->
        <TabControl Grid.Row="1" Name="TabControlPrime" BorderThickness="0" Margin="5,0,5,5">
            <TabItem Name="TabServers" Header="Servers" Width="140">
                <Grid Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DataGrid Name="ServersDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Width="220" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="Number" Width="80" Binding="{Binding Number}"/>
                            <DataGridTextColumn Header="Status" Width="120" Binding="{Binding Status}"/>
                            <DataGridTemplateColumn Header="Connect" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Connect" Click="ServerConnectButton_Click" Tag="{Binding}" Padding="5,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Disconnect" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Disconnect" Click="ServerDisconnectButton_Click" Tag="{Binding}" Padding="5,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Name="TabBots" Header="Bots" Width="140">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Список ботов удалённого терминала + создание/удаление (wiki_robots_list, bot_create, bot_delete) -->
                    <Grid Grid.Column="0" Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Name="ButtonCreateBot" Content="Create..." Height="26" Margin="0,0,5,0" Click="ButtonCreateBot_Click"/>
                            <Button Grid.Column="1" Name="ButtonDeleteBot" Content="Delete" Width="80" Height="26" Click="ButtonDeleteBot_Click"/>
                        </Grid>

                        <DataGrid Grid.Row="1" Name="BotsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="BotsDataGrid_SelectionChanged"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Number" Width="60" Binding="{Binding Number}"/>
                                <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Class" Width="130" Binding="{Binding ClassName}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Подробности выбранного бота: журнал / параметры / настройка вкладки-коннектора -->
                    <TabControl Grid.Column="1" Name="BotDetailsTabControl" BorderThickness="0">
                        <TabItem Header="Journal" Width="100">
                            <!-- bot_journal_get_summary + get_statistics (опрос, без push-событий — их пока нет на сервере) -->
                            <Grid Margin="5" Background="{DynamicResource PanelAltBrush}" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="P/L, abs" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Label Grid.Row="0" Grid.Column="1" Name="LabelBotProfitAbs" Content="—" VerticalAlignment="Center"/>
                                <Label Grid.Row="0" Grid.Column="2" Content="P/L, %" VerticalAlignment="Center"/>
                                <Label Grid.Row="0" Grid.Column="3" Name="LabelBotProfitPercent" Content="—" VerticalAlignment="Center"/>
                                <Label Grid.Row="1" Grid.Column="0" Content="Deals" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Label Grid.Row="1" Grid.Column="1" Name="LabelBotDeals" Content="—" VerticalAlignment="Center"/>
                                <Label Grid.Row="1" Grid.Column="2" Content="Commission" VerticalAlignment="Center"/>
                                <Label Grid.Row="1" Grid.Column="3" Name="LabelBotCommission" Content="—" VerticalAlignment="Center"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Parameters" Width="100">
                            <!-- bot_get_params / bot_set_params / bot_click_param_button -->
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0" Name="ParametersDataGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Style="{StaticResource DataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Width="220" Binding="{Binding Name}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Type" Width="110" Binding="{Binding TypeStr}" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Value" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <ComboBox ItemsSource="{Binding Values}"
                                                                  Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEditable="True"
                                                                  Visibility="{Binding IsEnumString, Converter={StaticResource BoolToVis}}"/>
                                                        <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsFreeText, Converter={StaticResource BoolToVis}}"/>
                                                        <CheckBox IsChecked="{Binding BoolValue}"
                                                                  VerticalAlignment="Center" Margin="4,0,0,0"
                                                                  Visibility="{Binding IsBoolLike, Converter={StaticResource BoolToVis}}"/>
                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDecimalCheckBox, Converter={StaticResource BoolToVis}}">
                                                            <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                                            <CheckBox IsChecked="{Binding BoolValue}" IsEnabled="False" Margin="6,0,0,0" ToolTip="on/off is read-only here for now"/>
                                                        </StackPanel>
                                                        <Button Content="Click" Padding="8,2" HorizontalAlignment="Left"
                                                                Tag="{Binding Name}" Click="ParamButton_Click"
                                                                Visibility="{Binding IsButton, Converter={StaticResource BoolToVis}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="ButtonSaveParameters" Content="Save parameters" Width="140" Height="28" Click="ButtonSaveParameters_Click"/>
                                    <Label Grid.Column="1" Name="LabelParametersStatus" Content="" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Tab config" Width="100">
                            <!-- bot_get_sources + bot_get/set_config_tab_simple|screener — включая режим эмуляции (emulator_is_on) -->
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Tab"/>
                                    <ComboBox Grid.Column="1" Name="TabsComboBox" Height="26" SelectionChanged="TabsComboBox_SelectionChanged"/>
                                </Grid>

                                <!-- Simple: одна биржа/бумага на вкладку (большинство ботов, включая FF14x) -->
                                <Grid Grid.Row="1" Name="SimpleConfigPanel" Visibility="Collapsed" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Server type"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="TextBoxSimpleServerType" VerticalAlignment="Center" Height="24"/>
                                    <Label Grid.Row="0" Grid.Column="2" Content="Server instance"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Name="TextBoxSimpleServerFullName" VerticalAlignment="Center" Height="24"
                                             ToolTip="Full name from Servers tab, e.g. 'BinanceFutures'"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Security class"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Name="TextBoxSimpleSecurityClass" VerticalAlignment="Center" Height="24"/>
                                    <Label Grid.Row="1" Grid.Column="2" Content="Security"/>
                                    <TextBox Grid.Row="1" Grid.Column="3" Name="TextBoxSimpleSecurityName" VerticalAlignment="Center" Height="24"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Portfolio"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Name="TextBoxSimplePortfolio" VerticalAlignment="Center" Height="24"/>
                                    <Label Grid.Row="2" Grid.Column="2" Content="Time frame"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" Name="ComboBoxSimpleTimeFrame" IsEditable="True" VerticalAlignment="Center" Height="24"/>

                                    <Label Grid.Row="3" Grid.Column="0" Content="Commission type"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" Name="ComboBoxSimpleCommissionType" VerticalAlignment="Center" Height="24">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Percent"/>
                                        <ComboBoxItem Content="OneLotFix"/>
                                    </ComboBox>
                                    <Label Grid.Row="3" Grid.Column="2" Content="Commission value"/>
                                    <TextBox Grid.Row="3" Grid.Column="3" Name="TextBoxSimpleCommissionValue" VerticalAlignment="Center" Height="24"/>

                                    <CheckBox Grid.Row="4" Grid.Column="1" Name="CheckBoxSimpleEmulator" Content="Emulator mode" VerticalAlignment="Center"
                                              ToolTip="On: the bot only simulates orders against real market data, no real trading"/>
                                </Grid>

                                <!-- Screener: несколько бумаг на вкладку (FF142Regime и т.п.) — список бумаг здесь не редактируется -->
                                <Grid Grid.Row="1" Name="ScreenerConfigPanel" Visibility="Collapsed" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Server type"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Name="TextBoxScreenerServerType" VerticalAlignment="Center" Height="24"/>
                                    <Label Grid.Row="0" Grid.Column="2" Content="Server instance"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Name="TextBoxScreenerServerName" VerticalAlignment="Center" Height="24"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Portfolio"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Name="TextBoxScreenerPortfolio" VerticalAlignment="Center" Height="24"/>
                                    <Label Grid.Row="1" Grid.Column="2" Content="Time frame"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" Name="ComboBoxScreenerTimeFrame" IsEditable="True" VerticalAlignment="Center" Height="24"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Commission type"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" Name="ComboBoxScreenerCommissionType" VerticalAlignment="Center" Height="24">
                                        <ComboBoxItem Content="None"/>
                                        <ComboBoxItem Content="Percent"/>
                                        <ComboBoxItem Content="OneLotFix"/>
                                    </ComboBox>
                                    <Label Grid.Row="2" Grid.Column="2" Content="Commission value"/>
                                    <TextBox Grid.Row="2" Grid.Column="3" Name="TextBoxScreenerCommissionValue" VerticalAlignment="Center" Height="24"/>

                                    <CheckBox Grid.Row="3" Grid.Column="1" Name="CheckBoxScreenerEmulator" Content="Emulator mode" VerticalAlignment="Center"
                                              ToolTip="On: the bot only simulates orders against real market data, no real trading"/>
                                    <Label Grid.Row="3" Grid.Column="2" Name="LabelScreenerSecuritiesCount" Content="" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Name="TextBlockTabUnsupported" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,10,0,0"
                                           Text="This tab type is not editable here yet — use the terminal directly."/>

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Name="ButtonSaveTabConfig" Content="Save tab config" Width="140" Height="28" Click="ButtonSaveTabConfig_Click"/>
                                    <Button Grid.Column="1" Name="ButtonReloadTabConfig" Content="Reload" Width="90" Height="28" Margin="5,0,0,0" Click="ButtonReloadTabConfig_Click"/>
                                    <Label Grid.Column="2" Name="LabelTabConfigStatus" Content="" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Лог: события SSE удалённого сервера (server_instance.*, terminal.*) + сообщения этого окна -->
        <Grid Grid.Row="2" Name="LogGrid" Margin="5" Background="{DynamicResource PanelAltBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Rectangle Height="29" Stroke="{DynamicResource PanelAltBorderBrush}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="5,3,1,0"/>
                <Label Content="Log" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,6,0,0" FontSize="12"/>
            </Grid>

            <DataGrid Grid.Row="1" Name="LogDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      Margin="5,5,1,1"
                      Style="{StaticResource DataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="150" Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"/>
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
