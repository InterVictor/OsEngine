<Window x:Class="OsEngine.OsTrader.Gui.RobotsVps.RobotsVpsInstancePickerUi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robots.VPS — choose a terminal" Width="360" SizeToContent="Height"
        Style="{StaticResource WindowStyleNoResize}"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Icon="/Images/OsLogo.ico">
    <!-- one button per terminal: a click opens it -->
    <Grid Background="{DynamicResource StandardBackgroundBrush}">
        <StackPanel Margin="12">
            <Label Content="Several terminals run on this VPS. Which one to open?" Margin="0,0,0,6"/>
            <ItemsControl Name="PanelInstances">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding}" Height="32" Margin="0,4" Click="ButtonInstance_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
